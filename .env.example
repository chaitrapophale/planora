# ==========================================================
# Planora GenAI Assistant Configuration
# ==========================================================

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
# Recommended options:
# - gemini-3-flash-preview (Recommended - fast, structured JSON output)
# - gemini-3.5-flash
# - gemini-3.8-flash
AI_MODEL=gemini-3-flash-preview

# Backend Server Port
PORT=3001
